rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Shop logos, keyed by the owner's uid: shop_logos/{uid}/logo.jpg
    //   READ:  any signed-in user (clients need to see shop logos).
    //   WRITE: only the owner writing their OWN folder, image only, <5 MB.
    // Storage rules can't read Firestore, so ownership is enforced by keying
    // the path on the uploader's uid.
    match /shop_logos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Shop cover/banner images, same owner-keyed rule as logos.
    match /shop_banners/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything else denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
