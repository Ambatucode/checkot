<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color - CHECKOT brand navy -->
    <item android:drawable="@color/checkot_navy"/>

    <!-- Logo, centered at a fixed size. Item width/height need API 23+;
         app minSdk is 26, so this is safe. -->
    <item
        android:width="130dp"
        android:height="120dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/checkot_logo"
            android:gravity="center" />
    </item>
</layer-list>
