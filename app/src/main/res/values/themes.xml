<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme (AndroidX core-splashscreen). One controlled splash across
         all Android versions: navy background + the CHECKOT logo, no white halo.
         The system masks the icon to a circle; on Android 12+ this replaces the
         OS default splash. postSplashScreenTheme is applied once the app draws. -->
    <style name="Theme.Checkot" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/checkot_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/checkot_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Checkot.App</item>
    </style>

    <!-- Your normal app theme (for after splash) -->
    <style name="Theme.Checkot.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/checkot_navy</item>
        <item name="android:statusBarColor">@color/checkot_navy</item>
        <item name="android:navigationBarColor">@color/checkot_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
