rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Returns true if the request is from a logged-in user
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns the full user document data from Firestore
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // Returns true if the current user is a shop owner
    function isOwner() {
      return isSignedIn()
        && getUserData(request.auth.uid).role == 'owner';
    }

    // Returns true if the current user owns a specific shop
    function ownsShop(shopId) {
      return isOwner()
        && getUserData(request.auth.uid).ownedShopId == shopId;
    }

    // Returns true if the current user is a super admin
    function isAdmin() {
      return isSignedIn()
        && getUserData(request.auth.uid).role == 'admin';
    }

    // Returns true if an owner has an active booking or chat link with a specific customer
    function ownerHasBookingWithUser(userId) {
      let shopId = getUserData(request.auth.uid).ownedShopId;
      return isOwner()
        && shopId != null
        && shopId != ''
        && (
          exists(/databases/$(database)/documents/chats/$(shopId)_$(userId))
          || exists(/databases/$(database)/documents/chats/$(userId)_$(shopId))
        );
    }

    // Returns true if no forbidden fields are being changed
    function isNotChanging(forbiddenFields) {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(forbiddenFields) == false;
    }

    // Validates that a value is a positive number
    function isPositiveNumber(value) {
      return value is number && value > 0;
    }

    // Returns true if the given shop exists and is approved/active.
    // Prevents booking against a fake, pending, or rejected shopId.
    function shopIsActive(shopId) {
      return exists(/databases/$(database)/documents/shop_services/$(shopId))
        && get(/databases/$(database)/documents/shop_services/$(shopId)).data.status == 'active';
    }

    // Returns true if user is a participant of a chat document
    function isChatParticipant(chatData) {
      return isSignedIn()
        && (request.auth.uid == chatData.customerId || request.auth.uid == chatData.ownerId);
    }

    // Returns true if user is a participant of the parent chat document
    function isParentChatParticipant(chatId) {
      return isSignedIn()
        && (request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.customerId
         || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId);
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {

      // --- READ ---
      // Users can read their own profile
      // Owners can only read profiles of users with active bookings at their shop
      // Admins can read any profile (needed for approval dashboard)
      allow read: if isSignedIn()
        && (request.auth.uid == userId
         || isAdmin()
         || (isOwner() && ownerHasBookingWithUser(userId)));

      // --- CREATE ---
      // Only during signup, user must match their UID
      // Must start as 'customer' or as 'owner' with a valid ownedShopId
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (
          request.resource.data.role == 'customer'
          ||
          (request.resource.data.role == 'owner'
           && request.resource.data.ownedShopId is string
           && request.resource.data.ownedShopId != '')
        );

      // --- UPDATE ---
      // Users can update their own profile
      // Cannot change: role, userId, ownedShopId (prevents privilege escalation)
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isNotChanging(['role', 'userId', 'ownedShopId'])
        && (!('savedCars' in request.resource.data)
            || request.resource.data.savedCars.size() <= 3);

      // --- DELETE ---
      // Users can delete their own profile
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ============================================================
    // BOOKINGS COLLECTION
    // ============================================================
    match /bookings/{bookingId} {

      // --- READ ---
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
         || ownsShop(resource.data.shopId)
         || isAdmin());

      // --- CREATE ---
      // Direct client creation is restricted to force clients through
      // the server-side createBooking Cloud Function (which uses Admin SDK).
      allow create: if false;

      // --- UPDATE (Customer) ---
      // Customer can only CANCEL their own PENDING or CONFIRMED booking
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.status == 'CANCELLED'
        && (resource.data.status == 'PENDING'
         || resource.data.status == 'CONFIRMED')
        && (request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'cancelledAt']));

      // --- UPDATE (Owner) ---
      // Owner can advance status for their own shop's bookings
      allow update: if ownsShop(resource.data.shopId)
        && (request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'confirmedAt',
                      'inProgressAt', 'completedAt',
                      'cancelledAt', 'servicedBy',
                      'paymentStatus', 'paidAt',
                      'assignedBay']));

      // --- DELETE ---
      // Nobody can hard-delete bookings from the client
      allow delete: if false;
    }

    // ============================================================
    // SHOP SERVICES COLLECTION
    // ============================================================
    match /shop_services/{shopId} {

      allow read: if isSignedIn();

      allow create: if ownsShop(shopId)
        && request.resource.data is map
        && request.resource.data.keys().hasAll(['services'])
        && request.resource.data.services is list
        && request.resource.data.status == 'pending';

      allow update: if (ownsShop(shopId)
        && (isNotChanging(['status', 'isDeleted'])
            || (request.resource.data.status == 'closed' && request.resource.data.isDeleted == true))
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 50
        && request.resource.data.bayCount is number
        && request.resource.data.bayCount >= 1
        && request.resource.data.bayCount <= 4)
        || (isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status']))
        || (ownsShop(shopId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['ownerFcmToken', 'status', 'isDeleted'])
            && request.resource.data.status == 'closed'
            && request.resource.data.isDeleted == true)
        || (ownsShop(shopId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['ownerFcmToken']));

      allow delete: if false;
    }

    // ============================================================
    // DAY SLOTS COLLECTION
    //   Per-shop-per-day bay reservation ledger.
    //   Only server-side Firebase Admin SDK (Cloud Functions) can write.
    //   Signed-in users keep read access.
    // ============================================================
    match /day_slots/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================================
    // REVIEWS COLLECTION
    //   A shop review, stored at reviews/{bookingId}.
    //   Validates that shopId is active and matches the booking's shopId.
    // ============================================================
    match /reviews/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.shopId is string
        && request.resource.data.shopId != ''
        && shopIsActive(request.resource.data.shopId)
        && request.resource.data.shopId == get(/databases/$(database)/documents/bookings/$(bookingId)).data.shopId
        && request.resource.data.userName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.createdAt is int
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'COMPLETED';
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ============================================================
    // CHATS COLLECTION
    //   Real-time in-app messaging between customer and shop owner.
    //   Restricted so read/write is strictly allowed ONLY if request.auth.uid
    //   matches the chat's customerId or ownerId.
    // ============================================================
    match /chats/{chatId} {
      allow read: if isChatParticipant(resource.data);
      allow create: if isChatParticipant(request.resource.data);
      allow update: if isChatParticipant(resource.data) && isChatParticipant(request.resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParentChatParticipant(chatId);
        allow create: if isParentChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ============================================================
    // DENY EVERYTHING ELSE BY DEFAULT
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
